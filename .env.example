# Copy to .env before running docker compose.

DB_NAME=lms
DB_USER=lms
DB_PASSWORD=lms
DB_PORT=5432

REDIS_PORT=6379
SERVER_PORT=8080

# Local demo only. Outside the dev profile the app refuses to start with this enabled.
ALLOW_SIMULATED_SETTLEMENT=true

# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
# The app refuses to start with this placeholder unless the profile is a development one.
JWT_SECRET=change-me-in-production-this-is-at-least-32-bytes-long

# Leave SMTP_HOST empty and mail is written to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@lms.local
